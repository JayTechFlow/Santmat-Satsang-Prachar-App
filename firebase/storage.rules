rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') 
             && request.resource.size < 5 * 1024 * 1024;
    }
    
    function isValidAudio() {
      return request.resource.contentType.matches('audio/.*') 
             && request.resource.size < 50 * 1024 * 1024;
    }

    function isValidDoc() {
      return request.resource.contentType.matches('application/pdf') 
             && request.resource.size < 20 * 1024 * 1024;
    }

    match /public/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /audio/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidAudio();
    }

    match /banners/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidImage();
    }

    match /thumbnails/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidImage();
    }

    match /books/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidDoc();
    }

    match /prayers/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId && isValidImage();
    }
  }
}
