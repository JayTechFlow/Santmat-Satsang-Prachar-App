rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =====================================================
    // HELPER FUNCTIONS — Authentication & RBAC (3-Role Model)
    // =====================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isActive() {
      return isAuthenticated() &&
             request.auth.token.get('accountStatus', 'active') != 'suspended';
    }

    function isDeveloperSuperAdmin() {
      return isActive() && (
        request.auth.token.get('role', '') == 'developer_super_admin'
      );
    }

    function isClientSuperAdmin() {
      return isActive() && (
        request.auth.token.get('role', '') == 'client_super_admin'
      );
    }

    function isAdmin() {
      return isDeveloperSuperAdmin() || isClientSuperAdmin();
    }

    function isMobileUser() {
      return isActive() && (
        request.auth.token.get('role', '') == 'mobile_user'
      );
    }

    function isOwner(userId) {
      return isActive() && request.auth.uid == userId;
    }

    // =====================================================
    // SECURITY CONSTRAINTS & INTEGRITY CHECKS
    // =====================================================

    // Prevent overwrite attacks on creation
    function isNewFile() {
      return resource == null;
    }

    // Prevent executable uploads (.exe, .sh, .bat, .cmd, .msi, .apk, .vbs, .js, .php, .py, .jar, etc.)
    function isNotExecutable() {
      return request.resource == null || (
        !request.resource.name.matches('.*\\.(exe|sh|bat|cmd|msi|apk|com|scr|vbs|jar|php|py|pl|cgi|asp|aspx|jsp|dll|sys|drv|elf|bin|ps1)$') &&
        !request.resource.contentType.matches('(?i)application/(x-msdownload|x-executable|x-sh|x-bat|x-dostype|x-msdos-program|x-elf|x-sharedlib|x-object|x-python|x-php|x-httpd-php|x-javascript|javascript|x-shockwave-flash)')
      );
    }

    // =====================================================
    // FILE TYPE & SIZE VALIDATORS (Prevent MIME spoofing & size limit violations)
    // =====================================================

    function isValidImage() {
      return request.resource == null || (
        isNotExecutable() &&
        request.resource.name.matches('.*\\.(jpg|jpeg|png|webp|gif|svg|ico)$') &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml|x-icon|vnd\\.microsoft\\.icon)') &&
        request.resource.size <= 10 * 1024 * 1024
      );
    }

    function isValidAudio() {
      return request.resource == null || (
        isNotExecutable() &&
        request.resource.name.matches('.*\\.(mp3|m4a|wav|ogg|aac|flac|opus)$') &&
        request.resource.contentType.matches('audio/(mpeg|mp4|wav|ogg|aac|x-m4a|flac|opus)') &&
        request.resource.size <= 100 * 1024 * 1024
      );
    }

    function isValidVideo() {
      return request.resource == null || (
        isNotExecutable() &&
        request.resource.name.matches('.*\\.(mp4|webm|mov|mkv|avi|m4v)$') &&
        request.resource.contentType.matches('video/(mp4|webm|quicktime|x-matroska|x-msvideo)') &&
        request.resource.size <= 500 * 1024 * 1024
      );
    }

    function isValidDocument() {
      return request.resource == null || (
        isNotExecutable() &&
        request.resource.name.matches('.*\\.(pdf|doc|docx|xls|xlsx|ppt|pptx|txt|csv)$') &&
        request.resource.contentType.matches('(application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument.*|text/plain|text/csv)') &&
        request.resource.size <= 50 * 1024 * 1024
      );
    }

    function isValidBook() {
      return request.resource == null || (
        isNotExecutable() &&
        request.resource.name.matches('.*\\.(pdf|epub|mobi|azw3|djvu|jpg|jpeg|png|webp)$') &&
        request.resource.contentType.matches('(application/pdf|application/epub\\+zip|application/x-mobipocket-ebook|application/x-djvu|image/(jpeg|png|webp))') &&
        request.resource.size <= 100 * 1024 * 1024
      );
    }

    function isValidAvatar() {
      return request.resource == null || (
        isNotExecutable() &&
        request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$') &&
        request.resource.contentType.matches('image/(jpeg|png|webp)') &&
        request.resource.size <= 5 * 1024 * 1024
      );
    }

    function isValidEventAttachment() {
      return request.resource == null || (
        isNotExecutable() &&
        request.resource.name.matches('.*\\.(jpg|jpeg|png|webp|pdf)$') &&
        request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)') &&
        request.resource.size <= 25 * 1024 * 1024
      );
    }

    function isValidTempFile() {
      return request.resource == null || (
        isNotExecutable() &&
        request.resource.size <= 50 * 1024 * 1024
      );
    }

    function isValidTrashFile() {
      return request.resource == null || (
        isNotExecutable() &&
        request.resource.size <= 500 * 1024 * 1024
      );
    }

    // =====================================================
    // PATH MATCHING RULES — 3-ROLE MODEL
    // =====================================================

    // Images — General purpose public images
    match /images/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidImage();
      allow update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Audio — Bhajans, Stuti Vinati, Satsangs
    match /audio/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidAudio();
      allow update: if isAdmin() && isValidAudio();
      allow delete: if isAdmin();
    }

    // Videos — Video satsangs & recordings (both /video/ and /videos/)
    match /video/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidVideo();
      allow update: if isAdmin() && isValidVideo();
      allow delete: if isAdmin();
    }

    match /videos/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidVideo();
      allow update: if isAdmin() && isValidVideo();
      allow delete: if isAdmin();
    }

    // Books — Spiritual literature, PDFs, EPUBs & covers
    match /books/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidBook();
      allow update: if isAdmin() && isValidBook();
      allow delete: if isAdmin();
    }


    // Suvichar — Daily thought images (admin panel)
    match /suvichar/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidImage();
      allow update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Book covers — Book cover images (admin panel)
    match /book_covers/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidImage();
      allow update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Book PDFs — Book documents (admin panel)
    match /book_pdfs/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidDocument();
      allow update: if isAdmin() && isValidDocument();
      allow delete: if isAdmin();
    }
    // Documents — General public documents & publications
    match /documents/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidDocument();
      allow update: if isAdmin() && isValidDocument();
      allow delete: if isAdmin();
    }

    // Events — Event banners & attachments
    match /events/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidEventAttachment();
      allow update: if isAdmin() && isValidEventAttachment();
      allow delete: if isAdmin();
    }

    // Avatars — User profile pictures (mobile_user can upload own)
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if (isOwner(userId) || isAdmin()) && isNewFile() && isValidAvatar();
      allow update: if (isOwner(userId) || isAdmin()) && isValidAvatar();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Banners — Promotional banners
    match /banners/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidImage();
      allow update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Temp — Transient uploads during client or server processing (mobile_user can upload own)
    match /temp/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && isNewFile() && isValidTempFile();
      allow update: if (isOwner(userId) || isAdmin()) && isValidTempFile();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Trash — Soft-deleted items & quarantine vault
    match /trash/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isNewFile() && isValidTrashFile();
      allow update: if isAdmin() && isValidTrashFile();
      allow delete: if isAdmin();
    }

    // Exports — Admin-generated exports (reports, CSV)
    match /exports/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isNewFile() && isNotExecutable();
      allow update: if isAdmin() && isNotExecutable();
      allow delete: if isAdmin();
    }

    // Processing — Backend pipeline working files
    match /processing/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false; // written only by Cloud Functions service account
      allow delete: if false;
    }

    // Backups — Admin-only backup storage
    match /backups/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false; // written only by Cloud Functions service account
      allow delete: if false;
    }

    // Legacy paths — kept for backward compatibility
    match /public/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidImage();
      allow update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidImage();
      allow update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    match /prayers/{allPaths=**} {
      allow read: if true;
      allow create: if isAdmin() && isNewFile() && isValidImage();
      allow update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isNewFile() && isValidAvatar();
      allow update: if isOwner(userId) && isValidAvatar();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
