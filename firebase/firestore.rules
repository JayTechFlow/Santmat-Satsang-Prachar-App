rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.get('userId', '') == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && !request.resource.data.keys().hasAny(['admin', 'role'])) || isAdmin();
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'role'])) || isAdmin();
      allow delete: if isAdmin();
      
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Publicly readable collections (read by authenticated app users, write by admin)
    match /app_settings/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /home_banners/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /banners/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /quick_actions/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /daily_suvichar/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /daily_quotes/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /featured_content/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /audio_categories/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /book_categories/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /categories/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /suvichar/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /roles/{docId} { allow read, write: if isAdmin(); }
    match /audio/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /stuti_vinati/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /books/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /notifications/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /analytics/{docId} { allow read, write: if isAdmin(); }
    match /audit_logs/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /search_index/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    
    match /preferences/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /downloads/{downloadId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isDocOwner() || isAdmin();
    }

    // Legacy collections (keep for now if needed, but restrict)
    match /satsangs/{satsangId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); 
    }
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /quotes/{quoteId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /donations/{donationId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
