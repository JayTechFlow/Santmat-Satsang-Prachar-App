rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isActive() {
      return isAuthenticated() && request.auth.token.get('accountStatus', 'active') != 'suspended';
    }

    function isMobileUser() {
      return isActive() && request.auth.token.get('role', '') == 'mobile_user';
    }

    function isClientSuperAdmin() {
      return isActive() && (
        request.auth.token.get('role', '') == 'client_super_admin' ||
        request.auth.token.get('role', '') == 'developer_super_admin'
      );
    }

    function isDeveloperSuperAdmin() {
      return isActive() && request.auth.token.get('role', '') == 'developer_super_admin';
    }

    function isAnyAdmin() {
      return isClientSuperAdmin() || isDeveloperSuperAdmin();
    }

    // Ownership implies a non-suspended account: suspended users must be
    // denied protected operations (Phase 8), matching storage.rules behavior.
    function isOwner(userId) {
      return isActive() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.get('userId', '') == request.auth.uid;
    }

    // Role-protected User management
    match /users/{userId} {
      allow read: if isOwner(userId) || isAnyAdmin();

      allow create: if (isOwner(userId) && !request.resource.data.keys().hasAny(['admin', 'roleIds'])
                        && request.resource.data.get('role', 'mobile_user') == 'mobile_user'
                        && request.resource.data.get('accountStatus', 'active') == 'active'
                        && request.resource.data.get('status', 'active') == 'active')
                    || isDeveloperSuperAdmin()
                    || (isClientSuperAdmin() && request.resource.data.get('role', '') != 'developer_super_admin' && !request.resource.data.get('roleIds', []).hasAny(['developer_super_admin']));

      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'role', 'roleIds', 'accountStatus', 'status', 'lastActiveAt']))
                    || isDeveloperSuperAdmin()
                    || (isClientSuperAdmin() && request.auth.uid != userId
                        && resource.data.get('role', '') != 'developer_super_admin'
                        && request.resource.data.get('role', '') != 'developer_super_admin'
                        && !request.resource.data.get('roleIds', []).hasAny(['developer_super_admin']));

      allow delete: if isDeveloperSuperAdmin() || (isClientSuperAdmin() && resource.data.get('role', '') != 'developer_super_admin');

      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) || isAnyAdmin();
      }
    }

    // Publicly readable collections (read by app users, write by admin)
    match /app_settings/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /banners/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /quick_actions/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /book_categories/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /categories/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /audio/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /stuti_vinati/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /books/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    // Notifications: broadcast documents (no userId field) remain publicly readable;
    // user-targeted documents (userId set) are readable ONLY by the target user or admins.
    // Clients never mutate this collection; per-user read/delete state is stored in
    // users/{uid}/notification_state (owner-scoped subcollection below).
    match /notifications/{docId} {
      allow read: if resource.data.get('userId', '') == ''
                  || isOwner(resource.data.get('userId', '__no_target__'))
                  || isAnyAdmin();
      allow create, update, delete: if isAnyAdmin();
    }

    // Enterprise Media Platform Collections (Sprint M1)
    // Media assets — authenticated users can read public assets; admin manages all
    match /media/{mediaId} {
      allow read: if isAuthenticated() &&
        (resource.data.get('visibility', 'authenticated') != 'admin_only' || isAnyAdmin());
      allow create: if isAnyAdmin();
      allow update: if isAnyAdmin();
      allow delete: if isAnyAdmin();
    }

    // Media versions — admin only
    match /media_versions/{versionId} {
      allow read: if isAnyAdmin();
      allow write: if isAnyAdmin();
    }


    // Media tags — authenticated users can read; admin manages
    match /media_tags/{tagId} {
      allow read: if isAuthenticated();
      allow write: if isAnyAdmin();
    }

    // Media categories — authenticated users can read; admin manages
    match /media_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAnyAdmin();
    }

    // Media audit log — admin read and write
    match /media_audit/{logId} {
      allow read: if isAnyAdmin();
      allow write: if isAnyAdmin();
    }

    // Media statistics — aggregate counters. Authenticated read; admin-only writes.
    // A mobile_user must never be able to forge play counts or analytics
    // (client increments, if needed later, must go through an authorized callable).
    match /media_statistics/{statId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAnyAdmin();
    }

    // Admin & system governance collections
    match /roles/{docId} { allow read, write: if isAnyAdmin(); }
    match /permissions/{docId} { allow read, write: if isAnyAdmin(); }
    match /system_config/{docId} { allow read, write: if isDeveloperSuperAdmin(); }
    match /analytics/{docId} { allow read, write: if isAnyAdmin(); }
    match /audit_logs/{docId} { allow read: if isDeveloperSuperAdmin(); allow write: if false; }

    match /preferences/{userId} {
      allow read, write: if isOwner(userId) || isAnyAdmin();
    }

    // Per-user devotional data (favorites, playlists, stats, sadhana) written by
    // the admin portal on behalf of a user and by the user themself.
    match /user_devotional_data/{userId} {
      allow read, write: if isOwner(userId) || isAnyAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if isDocOwner() || isAnyAdmin();
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isDocOwner() || isAnyAdmin();
    }

    // Legacy collections
    match /satsangs/{satsangId} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }
    match /donations/{donationId} {
      allow read: if isDocOwner() || isAnyAdmin();
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAnyAdmin();
    }

    // Playlist collections
    // Collaborators may edit playlist content but can never reassign ownership.
    match /playlists/{playlistId} {
      function isPlaylistOwner() {
        return isActive() && resource.data.ownerId == request.auth.uid;
      }
      allow read: if isAuthenticated() &&
        (resource.data.visibility == 'public' ||
         resource.data.ownerId == request.auth.uid ||
         request.auth.uid in resource.data.collaborators ||
         isAnyAdmin());
      allow create: if isActive() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isPlaylistOwner()
                    || isAnyAdmin()
                    || (isActive()
                        && request.auth.uid in resource.data.collaborators
                        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isPlaylistOwner() || isAnyAdmin();
    }

    // Support tickets — authenticated mobile users create their own tickets;
    // admins read, update, and delete all tickets.
    match /support_tickets/{ticketId} {
      allow read: if isAnyAdmin() || (isAuthenticated() && resource.data.get('submittedBy', '') == request.auth.uid);
      allow create: if isActive()
        && request.resource.data.get('submittedBy', '') == request.auth.uid
        && request.resource.data.get('subject', '') is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.subject.size() <= 300
        && request.resource.data.get('message', '') is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 5000
        && request.resource.data.get('category', '') in ['bug', 'feature_request', 'content_issue', 'account_access', 'general']
        && request.resource.data.get('priority', '') in ['low', 'medium', 'high', 'urgent']
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('createdAt', '') is string
        && request.resource.data.get('contactEmail', '') is string;
      allow update: if isAnyAdmin()
        || (isActive()
            && resource.data.get('submittedBy', '') == request.auth.uid
            && resource.data.get('status', '') == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'contactEmail', 'updatedAt']));
      allow delete: if isAnyAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // ── Analytics event pipeline (Reports) ────────────────────────────────
    // These collections are written and read ONLY by Cloud Functions using the
    // Admin SDK, which bypasses these rules. They are explicitly denied to
    // clients rather than relying on the catch-all above, so that a future
    // refactor cannot accidentally open an analytics collection and let a
    // client forge play counts, listening time or activity heartbeats.
    //
    // Write path:  recordPlaybackSession / touchActiveUser callables, which
    //              force uid from context.auth and never trust the payload.
    // Read path:   getAnalyticsSummary callable (admin-only) and the
    //              aggregation engine.
    match /playback_events/{docId}   { allow read, write: if false; }
    match /interaction_logs/{docId}  { allow read, write: if false; }
    match /telemetry_events/{docId}  { allow read, write: if false; }
    match /analytics_daily/{docId}   { allow read, write: if false; }
    match /analytics_summary/{docId} { allow read, write: if false; }
  }
}