rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isActive() {
      return isAuthenticated() && request.auth.token.get('accountStatus', 'active') != 'suspended';
    }

    function isMobileUser() {
      return isActive() && request.auth.token.get('role', '') == 'mobile_user';
    }

    function isClientSuperAdmin() {
      return isActive() && (
        request.auth.token.get('role', '') == 'client_super_admin' ||
        request.auth.token.get('role', '') == 'developer_super_admin'
      );
    }

    function isDeveloperSuperAdmin() {
      return isActive() && request.auth.token.get('role', '') == 'developer_super_admin';
    }

    function isAnyAdmin() {
      return isClientSuperAdmin() || isDeveloperSuperAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.get('userId', '') == request.auth.uid;
    }

    // Role-protected User management
    match /users/{userId} {
      allow read: if isOwner(userId) || isAnyAdmin();

      allow create: if (isOwner(userId) && !request.resource.data.keys().hasAny(['admin', 'role', 'roleIds', 'accountStatus', 'status']))
                    || isDeveloperSuperAdmin()
                    || (isClientSuperAdmin() && request.resource.data.get('role', '') != 'developer_super_admin' && !request.resource.data.get('roleIds', []).hasAny(['developer_super_admin']));

      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'role', 'roleIds', 'accountStatus', 'status']))
                    || isDeveloperSuperAdmin()
                    || (isClientSuperAdmin() && request.auth.uid != userId
                        && resource.data.get('role', '') != 'developer_super_admin'
                        && request.resource.data.get('role', '') != 'developer_super_admin'
                        && !request.resource.data.get('roleIds', []).hasAny(['developer_super_admin']));

      allow delete: if isDeveloperSuperAdmin() || (isClientSuperAdmin() && resource.data.get('role', '') != 'developer_super_admin');

      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) || isAnyAdmin();
      }
    }

    // Publicly readable collections (read by app users, write by admin)
    match /app_settings/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /home_banners/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /banners/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /quick_actions/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /daily_suvichar/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /daily_quotes/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /featured_content/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /audio_categories/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /book_categories/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /categories/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /suvichar/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /audio/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /stuti_vinati/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /books/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /notifications/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /search_index/{docId} { allow read: if true; allow write: if isAnyAdmin(); }

    // Enterprise Media Platform Collections (Sprint M1)
    // Media assets — authenticated users can read public assets; admin manages all
    match /media/{mediaId} {
      allow read: if isAuthenticated() &&
        (resource.data.get('visibility', 'authenticated') != 'admin_only' || isAnyAdmin());
      allow create: if isAnyAdmin();
      allow update: if isAnyAdmin();
      allow delete: if isAnyAdmin();
    }

    // Media versions — admin only
    match /media_versions/{versionId} {
      allow read: if isAnyAdmin();
      allow write: if isAnyAdmin();
    }

    // Media processing jobs — admin read and write
    match /media_processing_jobs/{jobId} {
      allow read, write: if isAnyAdmin();
    }
    match /media_jobs/{jobId} {
      allow read, write: if isAnyAdmin();
    }

    // Media tags — authenticated users can read; admin manages
    match /media_tags/{tagId} {
      allow read: if isAuthenticated();
      allow write: if isAnyAdmin();
    }

    // Media categories — authenticated users can read; admin manages
    match /media_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAnyAdmin();
    }

    // Media audit log — admin read and write
    match /media_audit/{logId} {
      allow read: if isAnyAdmin();
      allow write: if isAnyAdmin();
    }

    // Media statistics — authenticated read; admin write/increment
    match /media_statistics/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Admin & system governance collections
    match /roles/{docId} { allow read, write: if isAnyAdmin(); }
    match /permissions/{docId} { allow read, write: if isAnyAdmin(); }
    match /system_config/{docId} { allow read, write: if isDeveloperSuperAdmin(); }
    match /analytics/{docId} { allow read, write: if isAnyAdmin(); }
    match /audit_logs/{docId} { allow read: if isDeveloperSuperAdmin(); allow write: if false; }

    match /preferences/{userId} {
      allow read, write: if isOwner(userId) || isAnyAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if isDocOwner() || isAnyAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isDocOwner() || isAnyAdmin();
    }

    // Legacy collections
    match /satsangs/{satsangId} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }
    match /quotes/{quoteId} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }
    match /donations/{donationId} {
      allow read: if isDocOwner() || isAnyAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAnyAdmin();
    }

    // Playlist collections
    match /playlists/{playlistId} {
      allow read: if isAuthenticated() && 
        (resource.data.visibility == 'public' || 
         resource.data.ownerId == request.auth.uid ||
         request.auth.uid in resource.data.collaborators ||
         isAnyAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.ownerId == request.auth.uid || 
         request.auth.uid in resource.data.collaborators ||
         isAnyAdmin());
      allow delete: if isAuthenticated() && 
        (resource.data.ownerId == request.auth.uid || isAnyAdmin());
    }

    match /playlist_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAnyAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}